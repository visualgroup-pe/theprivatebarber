# Datos pendientes del brief. Mientras falten, la web muestra los [marcadores] del lienzo.

# Contacto (pie, hero y enlaces de WhatsApp)
NEXT_PUBLIC_WHATSAPP_NUMERO=          # 9 dígitos, sin +51
NEXT_PUBLIC_INSTAGRAM=                # sin @
NEXT_PUBLIC_CORREO=

# Reseñas: enlace para escribir una reseña en el perfil de Google
NEXT_PUBLIC_GOOGLE_RESENA_URL=

# Datos legales (privacidad, términos, Libro de Reclamaciones)
NEXT_PUBLIC_RAZON_SOCIAL=
NEXT_PUBLIC_RUC=
NEXT_PUBLIC_DOMICILIO_FISCAL=
NEXT_PUBLIC_ANPD_CODIGO=              # inscripción del banco de datos ante la ANPD
NEXT_PUBLIC_LEGAL_ACTUALIZACION=      # p. ej. «15 de diciembre de 2026»

# Supabase (Project Settings → API). La clave secreta solo vive en el servidor.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=  # o NEXT_PUBLIC_SUPABASE_ANON_KEY
SUPABASE_SECRET_KEY=                   # o SUPABASE_SERVICE_ROLE_KEY
SUPABASE_PROJECT_REF=mqrqdmmexrpheljkpthg

# Solo para npm run db:migrar / db:tipos (token personal; no va en Vercel)
SUPABASE_ACCESS_TOKEN=

# ── Avisos (etapa 7). Un canal sin sus claves se omite sin romper nada.
# URL pública del sitio, para los enlaces de los mensajes
SITIO_URL=                             # p. ej. https://[dominio]
# Correo con Resend (dominio verificado con SPF y DKIM)
RESEND_API_KEY=
CORREO_REMITENTE=                      # p. ej. The Private Barber <citas@[dominio]>
CORREO_RESPONDER_A=                    # opcional: a dónde llegan las respuestas
# WhatsApp Cloud API (Meta): número de WhatsApp Business y plantillas aprobadas (docs/plantillas-whatsapp.md)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_SECRET=                   # firma del webhook /api/whatsapp/webhook
WHATSAPP_VERIFY_TOKEN=                 # el que se escribe al suscribir el webhook en Meta
WHATSAPP_IDIOMA=es
WHATSAPP_API_VERSION=v23.0
# Administración: recibe alertas y las hojas de reclamación
ADMIN_CORREO=
ADMIN_WHATSAPP=                        # 9 dígitos
AVISO_SIN_RESPUESTA_HORAS=4            # pendiente del brief: [X horas]
# Vercel Cron lo envía como «Authorization: Bearer …» a /api/cron/avisos
CRON_SECRET=
